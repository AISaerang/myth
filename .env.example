# Copy to .env.local; never commit actual secrets.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# Shared temporary password prefilled on Personel & Akses (create/reset)
# and in the per-person invite message. Users must change it on first login.
# Leave unset to use the built-in fallback 1234567890ais.
DEFAULT_TEMP_PASSWORD="1234567890ais"

# One-time bootstrap only; remove/disable after initial admin setup.
BOOTSTRAP_ADMIN_USERNAME="replace-me"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-temporary-password"

# Optional: only when implementing Google Drive OAuth/API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
